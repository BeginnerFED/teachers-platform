# --- API ---
# Server-only. Under this design the browser never calls the API directly; only the Next
# server does, so this must not be a NEXT_PUBLIC_ variable.
API_URL=

# --- Supabase ---
# Browser-safe keys only. The secret key belongs in apps/api/.env and must never appear here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
