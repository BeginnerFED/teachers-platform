NODE_ENV=development
PORT=3001
WEB_ORIGIN=http://localhost:3000

# --- Supabase ---
SUPABASE_URL=
SUPABASE_PROJECT_REF=

# Server-side key: full access, bypasses row level security. Never send to the browser.
SUPABASE_SECRET_KEY=

# Legacy JWT equivalents, for anything that still expects them.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres password. A '+' has to be percent-encoded as %2B inside a connection URL.
SUPABASE_DB_PASSWORD=
DATABASE_URL=

# Personal access token for the Supabase CLI. Not used by the running app.
SUPABASE_ACCESS_TOKEN=

# --- Cloudflare Workers AI ---
# Cloudflare dashboard account ID and a server-side token with Workers AI access.
# Both are optional for local development and required together in production.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Workers AI model identifier. Override this to use another supported model.
CLOUDFLARE_AI_MODEL=@cf/google/gemma-4-26b-a4b-it
