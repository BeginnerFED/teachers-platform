{
  "name": "@tp/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "type-check": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "clean": "rimraf dist .turbo"
  },
  "dependencies": {
    "@hono/node-server": "^1",
    "@hono/zod-validator": "^0.9.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tp/shared": "workspace:*",
    "hono": "^4",
    "jose": "^6.2.10",
    "pino": "^10.3.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.39.5",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "rimraf": "^6",
    "tsup": "^8",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  }
}
