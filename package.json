{
  "name": "teachers-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter=@tp/web",
    "dev:api": "turbo dev --filter=@tp/api",
    "build": "turbo build",
    "start": "turbo start",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo clean"
  },
  "devDependencies": {
    "prettier": "^3",
    "prettier-plugin-tailwindcss": "^0.6",
    "turbo": "^2",
    "typescript": "^5"
  }
}
